{"author":"IMT01306618","category":"Game mechanic","dimension":"","extensionNamespace":"","fullName":"State machine","gdevelopVersion":"","helpPath":"","iconUrl":"","name":"StateMachine","previewIconUrl":"","shortDescription":"One state, a table of allowed moves, and a counter of the moves it refused.","version":"1.0.0","description":"A reusable state machine. The Rules property lists which state may go to which. ChangeState refuses any move not in the rules and counts it. Written for IMT01306618 Week 10.","tags":["state"],"authorIds":[],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[],"eventsFunctionsFolderStructure":{"folderName":"__ROOT"},"eventsBasedBehaviors":[{"description":"One current state, a rules table, and a count of blocked moves.","fullName":"State machine","helpPath":"","iconUrl":"","name":"StateMachine","objectType":"","previewIconUrl":"","eventsFunctions":[{"description":"Change state","fullName":"ChangeState","functionType":"Action","name":"ChangeState","sentence":"Change state of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const b = eventsFunctionContext.getObjects(\"Object\")[0]","  .getBehavior(eventsFunctionContext.getBehaviorName(\"Behavior\"));","const next = eventsFunctionContext.getArgument(\"next\");","const now = b._getState();","if (next === now) return;","","// Rules look like \"idle>run,jump;run>idle\". Read them into a table.","const rules = {};","for (const part of b._getRules().split(\";\")) {","  const [from, to] = part.split(\">\");","  if (from) rules[from.trim()] = (to || \"\").split(\",\").map(s => s.trim()).filter(Boolean);","}","","if ((rules[now] || []).includes(next)) {","  b._setPrevious(now);","  b._setState(next);","} else {","  b._setBlocked(b._getBlocked() + 1);          // a move the rules do not allow","  console.warn(\"Blocked: \" + now + \" -> \" + next);","}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameter